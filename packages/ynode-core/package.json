{
  "name": "@ynode/core",
  "version": "0.1.0",
  "description": "Shared core types and node definitions for ynode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./nodes": {
      "import": "./dist/nodes/index.js",
      "require": "./dist/nodes/index.js",
      "types": "./dist/nodes/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "zod": "^3.24.1",
    "rimraf": "^5.0.0"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "license": "AGPL-3.0"
}
