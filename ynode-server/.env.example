# YNode Server Environment Configuration

# Port to run the server on (default: 3001)
PORT=3001

# JWT Secret for authentication (generate with: openssl rand -base64 32)
# Optional for user security
JWT_SECRET=your-jwt-secret-here

# Encryption key for sensitive credentials (generate with: openssl rand -hex 32)
# Required for encrypting node credentials in DB
CREDENTIAL_ENCRYPTION_KEY=your-encryption-key-here

# Database path (defaults to ./data/ynode.db)
# DB_PATH=./data/ynode.db

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
